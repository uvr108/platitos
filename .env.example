# Copia este archivo como .env (en tu equipo) o define estas variables en Vercel
# (Settings → Environment Variables).

# Contraseña del panel /admin.
ADMIN_PASSWORD=

# Base de datos Turso. Sin ellas, en tu equipo se usa el archivo data/tienda.db.
# En Vercel las crea la integración de Turso al conectarla al proyecto.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob para las fotos subidas. Sin él, en tu equipo se usa la carpeta uploads/.
# En Vercel lo crea el Blob store al conectarlo al proyecto.
BLOB_READ_WRITE_TOKEN=
